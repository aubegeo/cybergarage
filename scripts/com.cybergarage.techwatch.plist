<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cybergarage.techwatch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>scripts/tech_watch_ingest.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/geo/Downloads/cybergarage</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Une fois par jour a 6h, avant la routine article-quotidien-source-officielle -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/geo/Downloads/cybergarage/logs/techwatch_launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/geo/Downloads/cybergarage/logs/techwatch_launchd_err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <!-- Ne pas spammer si Ollama ou un flux RSS est down -->
    <key>ThrottleInterval</key>
    <integer>300</integer>
</dict>
</plist>
